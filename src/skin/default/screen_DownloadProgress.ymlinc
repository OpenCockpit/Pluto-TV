screen:
  name: "DownloadProgress"
  backgroundColor: "transparent"
  position: "60,60"
  size: "620,200"
  children:
    - eLabel:
        alphatest: "blend"
        backgroundColor: "backgroundLight"
        cornerRadius: "8"
        position: "0,0"
        size: "620,200"
        widgetBorderColor: "gray"
        widgetBorderWidth: "2"
        zPosition: "-1"
    - widget:
        backgroundColor: "black"
        borderWidth: "1"
        font: "$FR_small"
        foregroundColor: "white"
        halign: "left"
        name: "action"
        noWrap: "1"
        position: "15,10"
        size: "590,30"
        transparent: "1"
        valign: "center"
    - widget:
        alphatest: "blend"
        backgroundColor: "backgroundDark"
        borderWidth: "0"
        name: "progress"
        pixmap: "~/../images/progress.png"
        position: "15,100"
        size: "590,12"
        zPosition: "2"
    - widget:
        backgroundColor: "black"
        borderColor: "black"
        borderWidth: "1"
        font: "$FR_small"
        foregroundColor: "white"
        halign: "center"
        name: "status"
        noWrap: "1"
        position: "15,120"
        size: "590,30"
        transparent: "1"
        valign: "center"
