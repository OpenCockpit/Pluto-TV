screen:
  backgroundColor: "#ff000000"
  flags: "wfNoBorder"
  name: "DownloadProgress"
  position: "60,60"
  resolution: "1920,1080"
  size: "620,200"
  children:
    - xmlinc:
        file: "screenpart_fonts.noymlinc"
    - eLabel:
        alphatest: "blend"
        backgroundColor: "#2d101214"
        cornerRadius: "8"
        position: "0,0"
        size: "620,200"
        widgetBorderColor: "#2d888888"
        widgetBorderWidth: "2"
        zPosition: "-1"
    - widget:
        backgroundColor: "#000000"
        borderColor: "black"
        borderWidth: "1"
        font: "$FR_small"
        foregroundColor: "#dfdfdf"
        halign: "left"
        name: "action"
        noWrap: "1"
        position: "15,10"
        size: "590,30"
        transparent: "1"
        valign: "center"
    - widget:
        alphatest: "blend"
        backgroundColor: "#1143495b"
        borderWidth: "0"
        name: "progress"
        pixmap: "/usr/lib/enigma2/python/Plugins/Extensions/%PLUGIN%/skin/images/progress.png"
        position: "15,100"
        size: "590,12"
        zPosition: "2"
    - eLabel:
        backgroundColor: "#102a3b58"
        name: "progess_background"
        position: "15,100"
        size: "590,12"
    - widget:
        backgroundColor: "#000000"
        borderColor: "black"
        borderWidth: "1"
        font: "$FR_verysmall"
        foregroundColor: "#dfdfdf"
        halign: "center"
        name: "wait"
        noWrap: "1"
        position: "15,65"
        size: "590,30"
        transparent: "1"
        valign: "center"
    - widget:
        backgroundColor: "#000000"
        borderColor: "black"
        borderWidth: "1"
        font: "$FR_small"
        foregroundColor: "#ffffff"
        halign: "center"
        name: "status"
        noWrap: "1"
        position: "15,120"
        size: "590,30"
        transparent: "1"
        valign: "center"
