screen:
  flags: "wfNoBorder"
  name: "%PLUGIN%"
  position: "fill"
  resolution: "1920,1080"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_fonts.ymlinc"
    - ePixmap:
        pixmap: "~/../images/backdrop.jpg"
        position: "0,0"
        scale: "scale"
        size: "e,1020"
        zPosition: "-1"
    - eLabel:
        backgroundColor: "black"
        cornerRadius: "12"
        position: "70,30"
        size: "1780,90"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        font: "$FR_big"
        foregroundColor: "#00ffff00"
        halign: "center"
        position: "400,48"
        render: "Label"
        size: "1150,55"
        source: "playlist"
        transparent: "1"
        zPosition: "2"
    - widget:
        backgroundColor: "#00000000"
        font: "$FR_bigger"
        halign: "right"
        position: "e-400,48"
        render: "Label"
        size: "300,55"
        source: "global.CurrentTime"
        transparent: "1"
        zPosition: "5"
        children:
          - convert:
              type: "ClockToText"
              text: "Format:%H:%M"
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/transblack.png"
        position: "70,170"
        scale: "scale"
        size: "615,740"
        transparent: "1"
        zPosition: "1"
    - widget:
        enableWrapAround: "1"
        name: "feedlist"
        position: "70,170"
        scrollbarMode: "showOnDemand"
        size: "615,740"
        transparent: "1"
        zPosition: "5"
    - widget:
        alphatest: "blend"
        pixmap: "~/../images/transblack.png"
        position: "70,950"
        render: "Pixmap"
        size: "615,50"
        source: "updated"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
        font: "$FR_small"
        halign: "center"
        position: "70,950"
        render: "Label"
        size: "615,50"
        source: "updated"
        transparent: "1"
        valign: "center"
        zPosition: "5"
    - widget:
        backgroundColor: "black"
        font: "$FR_biggest"
        halign: "center"
        name: "loading"
        position: "center,center"
        size: "800,60"
        transparent: "0"
        valign: "center"
        zPosition: "10"
    - widget:
        alphatest: "blend"
        pixmap: "~/../images/transblack.png"
        position: "685,170"
        render: "Pixmap"
        size: "1165,750"
        source: "vtitle"
        transparent: "1"
        zPosition: "0"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        font: "$FR_big"
        foregroundColor: "orange"
        position: "778,180"
        render: "Label"
        size: "1065,48"
        source: "vtitle"
        transparent: "1"
        zPosition: "5"
    - widget:
        alphatest: "blend"
        backgroundColor: "black"
        cornerRadius: "27"
        font: "Regular;0"
        foregroundColor: "black"
        name: "posterBG"
        position: "733,233"
        size: "472,679"
        widgetBorderColor: "#00ffde2b"
        widgetBorderWidth: "2"
        zPosition: "3"
    - widget:
        alphatest: "blend"
        backgroundColor: "black"
        cornerRadius: "25"
        name: "poster"
        position: "735,235"
        size: "468,675"
        transparent: "1"
        zPosition: "5"
    - widget:
        font: "$FR_small"
        name: "info"
        position: "1223,235"
        size: "619,675"
        transparent: "1"
        zPosition: "5"
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
