screen:
  name: "%PLUGIN%"
  position: "fill"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_defaults.ymlinc"
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - ePixmap:
        pixmap: "~/../images/backdrop.jpg"
        position: "0,0"
        scale: "scale"
        size: "$screen_width,1020"
        zPosition: "-1"
    - xmlinc:
        file: "screenpart_PRSPluginBody.ymlinc"
        position: "($screen_width-$child_width)/2,150"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
