- eLabel:
    backgroundColor: "backgroundMedium"
    position: "0,0"
    size: "615,740"
    zPosition: "1"
- widget:
    enableWrapAround: "1"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showOnDemand"
    size: "615,740"
    source: "feedlist"
    transparent: "1"
    zPosition: "5"
    children:
      - xmlinc:
          file: "screenpart_PRSList.ymlinc"
- widget:
    alphatest: "blend"
    font: "$FR_medium"
    position: "0,780"
    render: "Label"
    size: "1000,50"
    source: "updated"
    transparent: "1"
    valign: "center"
    zPosition: "5"
- widget:
    backgroundColor: "black"
    font: "$FR_biggest"
    halign: "center"
    name: "loading"
    position: "center,center"
    size: "800,60"
    transparent: "0"
    valign: "center"
    zPosition: "10"
- widget:
    font: "$FR_big"
    foregroundColor: "orange"
    backgroundColor: "black"
    position: "665,0"
    render: "Label"
    valign: "top"
    size: "1132,48"
    source: "vtitle"
    zPosition: "5"
    children:
      - convert:
          type: "ConditionalShowHide"
- widget:
    alphatest: "blend"
    backgroundColor: "black"
    cornerRadius: "27"
    font: "Regular;0"
    foregroundColor: "black"
    name: "posterBG"
    position: "663,63"
    size: "472,679"
    widgetBorderColor: "yellow"
    widgetBorderWidth: "2"
    zPosition: "3"
- widget:
    alphatest: "blend"
    backgroundColor: "black"
    cornerRadius: "25"
    scaleFlags: "scaleCenter"
    name: "poster"
    position: "665,65"
    size: "468,675"
    transparent: "1"
    zPosition: "5"
- widget:
    backgroundColor: "backgroundMedium"
    font: "$FR_medium"
    name: "info"
    position: "1180,65"
    size: "615,675"
    transparent: "0"
    zPosition: "5"
